    {"label": "GW150914 face on from 410 Mpc at 100 Hz", "off": 0.0, "limit": 1e-15, "shown": "h = 1.622e-21"},
    {"label": "against the bodies' quadrupole, face on", "off": 4.6044535259248676e-5, "limit": 0.0002007914279955319, "shown": "4.6e-5 off (limit twice GM/rc² = 2.0e-4)"},
    {"label": "and edge on", "off": 9.211452265667219e-5, "limit": 0.0002007914279955319, "shown": "9.2e-5 off"}
